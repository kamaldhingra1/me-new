---
---
<!-- Floating Toggle Button -->
<button
  id="contact-toggle-btn"
  class="contact-fab"
  aria-label="Contact Me"
>
  Contact Me
</button>

<!-- Contact Panel -->
<div id="contact-container" class="contact-panel">
  <div class="contact-header">
    <h3>Contact Me</h3>

    <button
      id="contact-close-btn"
      type="button"
      class="close-btn"
      aria-label="Close"
    >
      ✕
    </button>
  </div>

  <form id="contact-form">
    <div>
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required />
    </div>

    <div>
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required />
    </div>

    <div>
      <label for="message">Message</label>
      <textarea
        id="message"
        name="message"
        rows="3"
        required
      ></textarea>
    </div>

    <button type="submit" class="submit-btn">
      Send Message
    </button>
  </form>

  <div id="form-status"></div>
</div>

<style>
/* Floating button */
.contact-fab {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 1000;

  /* Modern Soft Rectangle Shape */
  border-radius: 12px;  /* Smooth, premium soft corners */
  padding: 14px 26px;   /* Balanced, comfortable click target */
  border: none;         /* Removed border to let the vibrant color pop */

  /* Vibrant Color Base (Electric Indigo Gradient) */
  background: linear-gradient(135deg, #4f46e5, #3b82f6); 
  color: #ffffff;       /* High contrast white text */

  /* Typography & Layout */
  font-family: sans-serif;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.5px;
  cursor: pointer;

  /* Smooth Glow & Elevation */
  box-shadow: 0 4px 14px rgba(79, 70, 229, 0.4);
  
  /* Animation */
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.contact-fab:hover {
  /* Vibrant Glow Hover State */
  background: linear-gradient(135deg, #4338ca, #2563eb); /* Slightly deeper gradient */
  box-shadow: 0 6px 20px rgba(79, 70, 229, 0.6);        /* Intensified glow effect */
  transform: translateY(-3px);                          /* Lifts up slightly more */
}

.contact-fab:active {
  transform: translateY(-1px);                          /* Mimics a physical press */
  box-shadow: 0 3px 10px rgba(79, 70, 229, 0.4);
}


 /* Contact Panel */
.contact-panel {
  position: fixed;
  right: 24px;
  bottom: 96px; /* Adjusted slightly to clear the taller vibrant FAB */
  z-index: 1000;

  width: 360px;
  max-width: calc(100vw - 32px);

  /* FIX: Changed 'inherit' to a frosted glass background so text is readable */
  background: rgba(15, 23, 42, 0.85); /* Premium dark slate with transparency */
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px); /* Safari support */

  /* Cohesive Soft Rect Border & Radius */
  border: 1px solid rgba(124, 173, 255, 0.3);
  border-radius: 16px;

  padding: 24px; /* Increased for better breathing room */

  /* Balanced Shadow Mix */
  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.3),
    0 0 40px rgba(124, 173, 255, 0.1);

  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);

  /* Ultra Smooth Custom Timing Function */
  transition:
    opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
    visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Open State */
.contact-panel.open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.contact-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.25rem;
}

.contact-header h3 {
  margin: 0;
  font-family: sans-serif;
  color: #7cadff;
  font-size: 1.25rem;
  font-weight: 700;
}

.close-btn {
  background: transparent;
  border: none;
  color: #7cadff;
  cursor: pointer;
  font-size: 1.5rem;
  padding: 4px;
  line-height: 1;
  transition: opacity 0.2s ease;
}

.close-btn:hover {
  opacity: 0.7;
}

.contact-panel label {
  display: block;
  margin-bottom: 6px;
  font-family: sans-serif;
  font-size: 0.875rem;
  font-weight: 600;
  color: #e2e8f0; /* Crisp light-gray label text */
}

.contact-panel input,
.contact-panel textarea {
  width: 100%;
  box-sizing: border-box;

  padding: 12px;
  margin-bottom: 16px;

  /* Sleek Minimalist Inputs */
  border: 1px solid rgba(124, 173, 255, 0.25);
  border-radius: 10px; /* Matching soft rect vibe */

  background: rgba(255, 255, 255, 0.03); 
  color: #ffffff; /* Explicitly set white text for input data */
  font-family: sans-serif;
  font-size: 0.95rem;
  transition: all 0.2s ease;
}

.contact-panel input:focus,
.contact-panel textarea:focus {
  outline: none;
  border-color: #3b82f6; /* Glow matches the vibrant FAB button */
  background: rgba(255, 255, 255, 0.07);
  box-shadow: 0 0 12px rgba(59, 130, 246, 0.25);
}

/* Submit Button - Pairs with Vibrant FAB */
.submit-btn {
  width: 100%;
  padding: 14px;

  border: none;
  border-radius: 10px;

  /* Matches the vibrant gradient theme of the main button */
  background: linear-gradient(135deg, #4f46e5, #3b82f6);
  color: #ffffff;
  font-family: sans-serif;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: 0.3px;

  cursor: pointer;
  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
  transition: all 0.2s ease;
}

.submit-btn:hover {
  background: linear-gradient(135deg, #4338ca, #2563eb);
  box-shadow: 0 6px 16px rgba(79, 70, 229, 0.4);
  transform: translateY(-1px);
}

.submit-btn:active {
  transform: translateY(0);
}

#form-status {
  margin-top: 14px;
  text-align: center;
  font-family: sans-serif;
  font-weight: 600;
  color: #34d399; /* Green status for successful sends */
}

/* Mobile */
@media (max-width: 640px) {
  .contact-panel {
    right: 16px;
    left: 16px;
    bottom: 84px; /* Ensure space above mobile FAB */
    width: auto;
    padding: 20px;
  }

  .contact-fab {
    right: 16px;
    bottom: 16px;
  }
}

</style>


<script>
document.addEventListener("astro:page-load", initContactForm);
document.addEventListener("DOMContentLoaded", initContactForm);

function initContactForm() {
/*   const toggleBtn = document.getElementById(
    "contact-toggle-btn"
  ) as HTMLButtonElement | null;

  const closeBtn = document.getElementById(
    "contact-close-btn"
  ) as HTMLButtonElement | null; */

  const contactPanel = document.getElementById(
    "contact-container"
  ) as HTMLDivElement | null;

  const form = document.getElementById(
    "contact-form"
  ) as HTMLFormElement | null;

  const status = document.getElementById(
    "form-status"
  ) as HTMLDivElement | null;

  // Prevent duplicate initialization after Astro navigation
  if (!contactPanel || contactPanel.dataset.initialized) {
    return;
  }

  contactPanel.dataset.initialized = "true";

  const openPanel = () => {
    contactPanel.classList.add("open");
  };

  const closePanel = () => {
    contactPanel.classList.remove("open");
  };

  // toggleBtn?.addEventListener("click", openPanel);
  // closeBtn?.addEventListener("click", closePanel);

  if (!form || !status) {
    return;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const data = new FormData(form);

    try {
      const response = await fetch(
        "https://api.postcatch.io/submit/6",
        {
          method: "POST",
          body: data,
          headers: {
            Accept: "application/json",
          },
        }
      );

      if (!response.ok) {
        throw new Error("Submission failed");
      }

      status.style.display = "block";
      status.style.color = "#4ade80";
      status.textContent =
        "✓ Thank you! Your message has been sent.";

      form.reset();

      setTimeout(() => {
        closePanel();
        status.textContent = "";
        status.style.display = "none";
      }, 1800);

    } catch (error) {
      console.error(error);

      status.style.display = "block";
      status.style.color = "#ef4444";
      status.textContent =
        "Something went wrong. Please try again.";
    }
  });
}

</script>